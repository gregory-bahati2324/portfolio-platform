# --- App ---
ENVIRONMENT=development   # production enables strict startup checks
LOG_LEVEL=INFO
LOG_JSON=false
SECRET_KEY=change-me-with-a-long-random-string
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

# --- Database / Redis ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@db:5432/portfolio
REDIS_URL=redis://redis:6379/0

# --- Gemini (server-side only, Phase 4) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=800
GEMINI_TEMPERATURE=0.4
GEMINI_TIMEOUT_SECONDS=20

# --- Media storage (Phase 3) ---
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=./media

# --- Public site / SEO ---
PUBLIC_SITE_URL=http://localhost:5173

# --- Email (optional; needed for newsletter confirmation and inquiry alerts) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=gregorybahati8@gmail.com
NOTIFY_EMAIL_FROM=

# --- Production only (docker-compose.prod.yml) ---
DOMAIN=gregtech.example
ALLOWED_HOSTS=["gregtech.example","www.gregtech.example"]
REDIS_PASSWORD=change-me-too
RATE_LIMIT_BACKEND=memory          # the prod compose file sets redis
WEB_CONCURRENCY=2
BACKUP_RETENTION_DAYS=14
